# --- LLM: choose ONE provider (openrouter | gemini | nvidia) ---
# Recommended for speed/reliability: gemini + gemini-2.8-flash
LLM_PROVIDER=gemini
MODEL=gemini-2.8-flash
GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=
LLM_TIMEOUT_SECONDS=300
LLM_CLIENT_RETRIES=2

# --- Security ---
SECRET_KEY=
# Protects every endpoint (incl. approve/reject). The Streamlit app sends it too.
APP_API_KEY=

# --- GitHub (token needs Contents + Pull requests: read/write on the repo) ---
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BASE_BRANCH=main


# --- Streamlit frontend only ---
BACKEND_URL=http://127.0.0.1:8000